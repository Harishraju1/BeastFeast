# Leave both empty to run in LOCAL MODE (accounts and projects stored in the browser on this device).
# Set them to enable cloud accounts, cross-device projects, server-validated XP and a campus-wide leaderboard.
# Supabase → Project Settings → API Keys. The "publishable" key (sb_publishable_…) or the legacy "anon" key both work here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — for `npm run db:push` and `npm run seed:supabase` on your own machine/CI.
# NEVER prefix these with NEXT_PUBLIC_, never commit them, never add them to the hosting provider's frontend env.
SUPABASE_URL=
# The "secret" key (sb_secret_…) or the legacy "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → "Session pooler" URI, with your database password filled in.
SUPABASE_DB_URL=
